{
  "name": "iem-tournament",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-data": "node -e \"require('fs').copyFileSync('../songs/manifest.json','public/data/songs.json')\"",
    "predev": "npm run sync-data",
    "dev": "vite --open /shell.html",
    "prebuild": "npm run sync-data",
    "build": "tsc -b && vite build --config vite.shell.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview --config vite.shell.config.ts",
    "android": "node scripts/build_android.mjs",
    "electron": "tsc -b && vite build --config vite.shell.config.ts && electron electron/shell-main.cjs",
    "dist": "node scripts/dist_shell.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@number0/iroh": "^1.2.0",
    "@types/three": "^0.186.0",
    "jsfive": "0.4.2",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "lottie-web": "5.12.2",
    "material-symbols": "^0.48.3",
    "music-metadata": "^12.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "main": "electron/shell-main.cjs",
  "build": {
    "appId": "local.iem-tournament",
    "productName": "IEM Tournament",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "dist/songs/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "public/icon.ico",
      "signAndEditExecutable": true
    }
  }
}
